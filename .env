# 服务器IP配置
EUREKA_SERVER_IP=example.com

# LoRa MQTT 认证（默认值：userName 为空、password 为空，即不启用认证）
LORA_MQTT_USERNAME=
LORA_MQTT_PASSWORD=

# 百度云短信（默认关闭；endpoint 固定为 http://smsv3.bj.baidubce.com）
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_SECRET_ACCESS_KEY=
SMS_SIGNATURE_ID=
# 告警模板：易定位：${name}触发${alarmtype}警报，请立即查看处理。
SMS_ALARM_TEMPLATE_ID=
